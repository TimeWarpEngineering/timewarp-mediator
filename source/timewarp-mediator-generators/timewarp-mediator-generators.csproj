<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TimeWarp.Mediator.Generators</RootNamespace>
    <AssemblyName>TimeWarp.Mediator.Generators</AssemblyName>
    <PackageId>TimeWarp.Mediator.Generators</PackageId>
    <Description>Source generator for TimeWarp.Mediator: builds the message graph at compile time and emits a sealed, reflection-free, AOT-friendly IMediator plus per-scope ISender&lt;TScope&gt;/IPublisher&lt;TScope&gt; named pipelines and AddGeneratedMediator() registration. Reports TWM007, TWM008, TWM010, and TWM011, and TWM012 when a GeneratedHandlerAttribute name is not a constant. TWM001–TWM004 and the missing-handler half of TWM012 ship in the TimeWarp.Mediator package.</Description>
    <PackageTags>$(PackageTags);source-generator;aot</PackageTags>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Repo-wide snupkg + no lib/ output yields an empty symbol package (NU5017). -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- RS1041 wants compiler extensions on netstandard2.0. Steven 2026-11-14: net11.0 only;
         Visual Studio and .NET Framework MSBuild are not supported, and the .NET 11 SDK compiler loads net11.0. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- TimeWarp.SourceGenerators is removed so it does not run inside this Roslyn component. -->
    <PackageReference Remove="TimeWarp.SourceGenerators" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared graph sources compile into this assembly. Referencing the analyzer DLL would
         fail to load in a package consumer (CS8784): Roslyn only loads a generator dependency
         when that DLL sits beside the generator, and the analyzer now ships in TimeWarp.Mediator. -->
    <Compile Include="..\timewarp-mediator-analyzers\diagnostic-descriptors.cs" Link="shared\diagnostic-descriptors.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\membership.cs" Link="shared\membership.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\membership-options.cs" Link="shared\membership-options.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\message-graph.cs" Link="shared\message-graph.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\message-graph-builder.cs" Link="shared\message-graph-builder.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\message-graph-builder.handlers.cs" Link="shared\message-graph-builder.handlers.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\message-graph-builder.constraints.cs" Link="shared\message-graph-builder.constraints.cs" />
    <Compile Include="..\timewarp-mediator-analyzers\handler-type-name.cs" Link="shared\handler-type-name.cs" />
    <AdditionalFiles Include="..\timewarp-mediator-analyzers\AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="..\timewarp-mediator-analyzers\AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Incrementality tests read the TrackingNames step names. -->
    <InternalsVisibleTo Include="timewarp-mediator-generators-compilation-tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)TimeWarp.Mediator.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build-transitive\timewarp-mediator-generators.props" Pack="true" PackagePath="buildTransitive\TimeWarp.Mediator.Generators.props" />
  </ItemGroup>

</Project>
