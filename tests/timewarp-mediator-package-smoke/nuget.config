<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- TimeWarp.Mediator.* may only come from the nupkgs dev pack just wrote. -->
  <packageSources>
    <clear />
    <add key="local-artifacts" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-artifacts">
      <package pattern="TimeWarp.Mediator.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
