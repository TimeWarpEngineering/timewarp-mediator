<Project>
  <PropertyGroup>
    <!-- Hosts that reference the generator are graph members even without [assembly: MediatorAssembly]. -->
    <TimeWarpMediatorAssembly Condition="'$(TimeWarpMediatorAssembly)' == ''">true</TimeWarpMediatorAssembly>
    <!-- The generator runs here and reports TWM001-TWM003; the analyzer then leaves them to it. -->
    <TimeWarpMediatorGenerator>true</TimeWarpMediatorGenerator>
    <TimeWarpMediatorNamespace Condition="'$(TimeWarpMediatorNamespace)' == ''">TimeWarp.Mediator.Generated</TimeWarpMediatorNamespace>
    <!-- Assembly name without a Compilation input, so InternalsVisibleTo and manifest membership stay cached. -->
    <TimeWarpMediatorAssemblyName Condition="'$(TimeWarpMediatorAssemblyName)' == ''">$(AssemblyName)</TimeWarpMediatorAssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="TimeWarpMediatorAssembly" />
    <CompilerVisibleProperty Include="TimeWarpMediatorGenerator" />
    <CompilerVisibleProperty Include="TimeWarpMediatorNamespace" />
    <CompilerVisibleProperty Include="TimeWarpMediatorAssemblyName" />
  </ItemGroup>
</Project>
