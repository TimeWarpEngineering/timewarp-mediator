<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TimeWarp.Mediator.Analyzers</RootNamespace>
    <AssemblyName>TimeWarp.Mediator.Analyzers</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Roslyn analyzers for TimeWarp.Mediator message graphs: TWM001 (request with no handler), TWM002 (duplicate handler), TWM003 (scope mismatch), TWM004 (wrong-scope send). Shipped as an analyzer asset inside the TimeWarp.Mediator package, not as its own nupkg.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Repo-wide snupkg + no lib/ output yields an empty symbol package (NU5017). -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- Floor is the Roslyn that ships with the .NET 10 SDK (Microsoft.CodeAnalysis.CSharp 5.0.0). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- TimeWarp.SourceGenerators is removed so it does not run inside this Roslyn component. -->
    <PackageReference Remove="TimeWarp.SourceGenerators" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
  </ItemGroup>

</Project>
