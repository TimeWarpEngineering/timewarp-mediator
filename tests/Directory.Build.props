<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory).., 'Directory.Build.props'))\Directory.Build.props" />
  
  <!-- Test-specific overrides -->
  <PropertyGroup>
    <!-- Relax strict compilation settings for tests. Nullable stays enabled from the root props;
         a project that opts out says so in its own csproj (props are imported before the csproj body,
         so a csproj value always wins). -->
    <Features></Features>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>