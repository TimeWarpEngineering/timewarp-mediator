<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <!-- Benchmarks print results to the console; ITerminal adds nothing here. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\source\timewarp-mediator-generators\build-transitive\timewarp-mediator-generators.props" />

  <!-- PublishAot lane. BenchmarkDotNet's host is not part of that compilation.
       dev benchmark aot sets BenchmarkAot and publishes this project. -->
  <PropertyGroup Condition="'$(BenchmarkAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <DefineConstants>$(DefineConstants);BENCHMARK_AOT</DefineConstants>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\timewarp-mediator\timewarp-mediator.csproj" />
    <ProjectReference Include="..\..\source\timewarp-mediator-generators\timewarp-mediator-generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\source\timewarp-mediator-analyzers\timewarp-mediator-analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The alias keeps that assembly's generated AddMediator extension out of this compilation. -->
    <ProjectReference Include="..\timewarp-mediator-benchmarks-martinothamar-scoped\timewarp-mediator-benchmarks-martinothamar-scoped.csproj">
      <Aliases>scopedmartin</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Condition="'$(BenchmarkAot)' != 'true'" />
    <PackageReference Include="MediatR" Condition="'$(BenchmarkAot)' != 'true'" />
    <PackageReference Include="Microsoft.Extensions.Logging" Condition="'$(BenchmarkAot)' != 'true'" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
