<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Central Package Management - package versions are pinned from discovered references -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build and analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="1.0.0" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.11" />
  </ItemGroup>

  <!-- tests/timewarp-mediator-package-smoke only: dev pack passes TimeWarpMediatorVersion (the
       <Version> it just packed), so these resolve to the local nupkgs and nothing else sees them. -->
  <ItemGroup Label="Package smoke" Condition="'$(TimeWarpMediatorVersion)' != ''">
    <PackageVersion Include="TimeWarp.Mediator" Version="[$(TimeWarpMediatorVersion)]" />
    <PackageVersion Include="TimeWarp.Mediator.Generators" Version="[$(TimeWarpMediatorVersion)]" />
  </ItemGroup>

  <ItemGroup Label="Dev CLI">
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.5" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.5" />
    <PackageVersion Include="TimeWarp.Amuru" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Terminal" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup Label="Product">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- 5.0.0 is the stable compiler package that matches the Roslyn shipped with the
         oldest .NET 10 SDK (10.0.100). Shipped components VersionOverride this pin, and
         Dependabot ignores Microsoft.CodeAnalysis.CSharp* so a weekly bump cannot move it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
  </ItemGroup>
</Project>
