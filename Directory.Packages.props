<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Central Package Management - package versions are pinned from discovered references -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build and analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="1.0.0" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.11" />
  </ItemGroup>

  <!-- tests/timewarp-mediator-package-smoke only: dev pack passes TimeWarpMediatorVersion (the
       <Version> it just packed), so these resolve to the local nupkgs and nothing else sees them. -->
  <ItemGroup Label="Package smoke" Condition="'$(TimeWarpMediatorVersion)' != ''">
    <PackageVersion Include="TimeWarp.Mediator" Version="[$(TimeWarpMediatorVersion)]" />
    <PackageVersion Include="TimeWarp.Mediator.Generators" Version="[$(TimeWarpMediatorVersion)]" />
  </ItemGroup>

  <ItemGroup Label="Dev CLI">
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.11" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.11" />
    <PackageVersion Include="TimeWarp.Amuru" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="2.0.0" />
    <PackageVersion Include="TimeWarp.Terminal" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup Label="Product">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- The pin may be any version the SDK in global.json can load.
         ReferencedCompiler_IsNotNewerThanTheSdkCompiler fails when the referenced
         compiler is newer than that SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Conditioned on $(TargetFramework) so a net10.0 host never restores the 11 RC. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <!-- 0.15.8 throws on a net11.0 host (RuntimeMoniker.NotRecognized) before it measures.
         net10.0 stays on 0.15.8, the tool that recorded comparison-baseline.md, so the
         regression gate measures with that tool. net11.0 uses 0.16.0-preview.2, which can
         name the 11 runtime. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <!-- Latest stable. net10.0 asset; net11.0 restores it by framework roll-forward. Test-only.
         MediatR 14 resolves ILoggerFactory when the mediator is constructed. -->
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.3.26522.148" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>
</Project>
