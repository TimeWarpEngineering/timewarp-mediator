<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>TimeWarp.Mediator.Analyzers</RootNamespace>
    <AssemblyName>TimeWarp.Mediator.Analyzers</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>Roslyn analyzers for TimeWarp.Mediator message graphs: TWM001 (request with no handler), TWM002 (duplicate handler), TWM003 (scope mismatch), TWM004 (wrong-scope send), and TWM012 (declared generated handler does not exist, or its name cannot be read in a library). Shipped as an analyzer asset inside the TimeWarp.Mediator package, not as its own nupkg.</Description>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Repo-wide snupkg + no lib/ output yields an empty symbol package (NU5017). -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!-- RS1041 wants compiler extensions on netstandard2.0. Steven 2026-11-14: net11.0 only;
         Visual Studio and .NET Framework MSBuild are not supported, and the .NET 11 SDK compiler loads net11.0. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- TimeWarp.SourceGenerators is removed so it does not run inside this Roslyn component. -->
    <PackageReference Remove="TimeWarp.SourceGenerators" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
  </ItemGroup>

</Project>
