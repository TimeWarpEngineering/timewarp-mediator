<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory).., 'Directory.Build.props'))\Directory.Build.props" />
  
  <!-- Sample-specific overrides -->
  <PropertyGroup>
    <!-- Disable strict compilation settings for samples -->
    <Nullable>disable</Nullable>
    <Features></Features>
    <SignAssembly>false</SignAssembly>
    <AssemblyOriginatorKeyFile></AssemblyOriginatorKeyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- RS0030: samples are console demos; Console stays readable for copy-paste and ITerminal adds a dependency. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>
</Project>