<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sibling generator for the generated-requests sample. It stands in for a consumer
       generator such as an action-set emitter. The sample host references it as an analyzer.
       netstandard2.0 is RS1041's fix. The TimeWarp.Mediator generator and analyzer are net11.0
       by decision (agent.md); this sample generator is not a package and is not covered by it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Remove="TimeWarp.SourceGenerators" />
  </ItemGroup>

</Project>
