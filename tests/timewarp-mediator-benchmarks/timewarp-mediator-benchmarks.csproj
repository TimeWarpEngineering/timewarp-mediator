<!-- Modified by Steven T. Cramer -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- MediatR-era benchmark code predates nullable annotations. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- Benchmarks print results to the console; ITerminal adds nothing here. -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <!-- ETW diagnosers (EtwProfiler, InliningDiagnoser) only load on Windows. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\source\timewarp-mediator\timewarp-mediator.csproj" />
  </ItemGroup>
</Project>