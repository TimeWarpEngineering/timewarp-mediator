<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Runtime for TimeWarp.Mediator: the reflection-based MediatR-fork dispatcher (AddMediator) plus the registration and pipeline infrastructure the source-generated mediator (AddGeneratedMediator, from TimeWarp.Mediator.Generators) builds on. Request/response, notifications, streams, and pipeline behaviors over Microsoft.Extensions.DependencyInjection.</Description>
    <TargetFrameworks>netstandard2.0;net6.0</TargetFrameworks>
    <RootNamespace>TimeWarp.Mediator</RootNamespace>
    <AssemblyName>TimeWarp.Mediator</AssemblyName>
    <PackageId>TimeWarp.Mediator</PackageId>
    <!-- Shipped package: every public member must be documented (root props suppress CS1591 for tests/samples). -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="IsExternalInit">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\timewarp-mediator-contracts\timewarp-mediator-contracts.csproj" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unit tests exercise ServiceRegistrar.GenerateCombinations directly; the tests project is signed with the same key. -->
    <InternalsVisibleTo Include="timewarp-mediator-tests" Key="" />
  </ItemGroup>

</Project>
