<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TimeWarpMediatorProfile>Aot</TimeWarpMediatorProfile>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <Import Project="..\..\src\TimeWarp.Mediator.Generators\buildTransitive\TimeWarp.Mediator.Generators.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Contracts\TimeWarp.Mediator.Contracts.csproj" />
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Generators\TimeWarp.Mediator.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Analyzers\TimeWarp.Mediator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
