    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TimeWarp.Mediator.Examples.NamedPipelines</RootNamespace>
  </PropertyGroup>

  <Import Project="..\..\src\TimeWarp.Mediator.Generators\buildTransitive\TimeWarp.Mediator.Generators.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Contracts\TimeWarp.Mediator.Contracts.csproj" />
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Generators\TimeWarp.Mediator.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\TimeWarp.Mediator.Analyzers\TimeWarp.Mediator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
