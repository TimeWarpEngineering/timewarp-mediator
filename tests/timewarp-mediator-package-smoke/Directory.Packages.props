<Project>
  <!-- Shadows the repo Directory.Packages.props. dev pack passes TimeWarpMediatorVersion
       (the <Version> it just packed) so the restore can only resolve the local nupkgs. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="TimeWarp.Mediator.Contracts" Version="[$(TimeWarpMediatorVersion)]" />
    <PackageVersion Include="TimeWarp.Mediator.Generators" Version="[$(TimeWarpMediatorVersion)]" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
</Project>
